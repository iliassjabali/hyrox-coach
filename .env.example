# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# LLM access — set ONE of the following.
# A) Vercel AI Gateway key (routes to Anthropic via Vercel; no Anthropic key needed):
AI_GATEWAY_API_KEY=
# B) Direct Anthropic Console key — Classifier (Haiku), Coach (Opus), Critic (Sonnet):
ANTHROPIC_API_KEY=

# Strava OAuth (Phase 4) — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
